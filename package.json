{
  "name": "minimi-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i public/style.css -o public/generated.css --minify",
    "predev": "npm run build:css",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "prestart": "npm run build:css",
    "start": "node --env-file-if-exists=.env src/server.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
